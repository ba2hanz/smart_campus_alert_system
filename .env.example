# Firebase Web Config
FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_WEB_APP_ID=your_web_app_id
FIREBASE_WEB_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Android Config
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_ANDROID_APP_ID=your_android_app_id

# Firebase iOS Config
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_IOS_APP_ID=your_ios_app_id
FIREBASE_IOS_BUNDLE_ID=com.example.yourApp

# Firebase Common
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Service account anahtarı BURAYA KONMAZ. Bu dosya bir Flutter asset'i olarak
# APK'nın içine girer; içindeki her şey uygulamayı açan herkes tarafından
# okunabilir. Push bildirimlerini Cloud Functions gönderir (functions/).
